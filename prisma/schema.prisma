generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  CLIENT
}

enum WorkerStatus {
  ACTIVE
  INACTIVE
}

enum SiteStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum SubmissionStatus {
  PENDING_SYNC
  SUBMITTED
  FLAGGED
  RETAKE_REQUESTED
}

enum IssueSeverity {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum IssueStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum ReportType {
  DAILY
  WEEKLY
  MONTHLY
}

enum ReportDeliveryStatus {
  PENDING
  GENERATED
  SENT
  FAILED
}

enum Industry {
  CONSTRUCTION
  FACILITY_MANAGEMENT
  HOME_SERVICES
  SOLAR_INSTALLATION
  SECURITY_PATROL
  LOGISTICS_DELIVERY
  GENERAL
}

enum WeatherCondition {
  CLEAR
  CLOUDY
  RAIN
  STORM
  WINDY
  HOT
  OTHER
}

enum EquipmentOwnership {
  OWNED
  RENTED
}

enum MBStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum MeasurementType {
  AREA       // No × L × B
  VOLUME     // No × L × B × H
  LENGTH     // No × L
  NOS        // Count only
  LUMP_SUM   // Fixed price
}

// ==================== COMPANY ====================

model Company {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  logo      String?  @db.VarChar(500)
  address   String?
  phone     String?  @db.VarChar(15)
  email     String?  @db.VarChar(255)
  gstNumber String?  @db.VarChar(15)
  industry       Industry?
  enabledModules String[]  @default([])
  planType       String    @default("free") @db.VarChar(20)
  isActive       Boolean   @default(true)
  settings       Json?
  onboardingDone Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  users     User[]
  workers   Worker[]
  sites     Site[]
  workTypes WorkType[]
  reports   Report[]

  @@map("companies")
}

// ==================== USERS (Web Dashboard) ====================

model User {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @db.Uuid
  email        String    @db.VarChar(255)
  passwordHash String    @db.VarChar(256)
  fullName     String    @db.VarChar(255)
  phone        String?   @db.VarChar(15)
  role         UserRole  @default(MANAGER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company          Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedSites    SiteManager[]
  clientSites      SiteClient[]
  createdDailyLogs DailySiteLog[]

  @@unique([companyId, email])
  @@map("users")
}

// ==================== WORKERS (Mobile App) ====================

model Worker {
  id           String       @id @default(uuid()) @db.Uuid
  companyId    String       @db.Uuid
  phone        String       @db.VarChar(15)
  name         String       @db.VarChar(255)
  photo        String?      @db.VarChar(500)
  language     String       @default("en") @db.VarChar(5)
  status       WorkerStatus @default(ACTIVE)
  deviceId     String?      @db.VarChar(255)
  lastActiveAt DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedSites SiteWorker[]
  submissions   Submission[]
  issues        Issue[]
  labourLogs    LabourLog[]

  @@unique([companyId, phone])
  @@index([companyId, status])
  @@map("workers")
}

// ==================== SITES ====================

model Site {
  id                 String     @id @default(uuid()) @db.Uuid
  companyId          String     @db.Uuid
  name               String     @db.VarChar(255)
  address            String?
  latitude           Float?
  longitude          Float?
  gpsRadiusMetres    Int        @default(200)
  status             SiteStatus @default(ACTIVE)
  minPhotosPerDay    Int        @default(1)
  beforeAfterEnabled Boolean    @default(false)
  expectedStartTime  String?    @db.VarChar(5)
  expectedEndTime    String?    @db.VarChar(5)
  contactName        String?    @db.VarChar(255)
  contactPhone       String?    @db.VarChar(15)
  notes              String?
  budget             Decimal?   @db.Decimal(14, 2)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  zones         Zone[]
  siteWorkTypes SiteWorkType[]
  workers       SiteWorker[]
  managers      SiteManager[]
  clients       SiteClient[]
  submissions      Submission[]
  issues           Issue[]
  reports          Report[]
  alerts           Alert[]
  dailySiteLogs    DailySiteLog[]
  measurementBooks MeasurementBook[]

  @@index([companyId, status])
  @@map("sites")
}

model Zone {
  id        String   @id @default(uuid()) @db.Uuid
  siteId    String   @db.Uuid
  name      String   @db.VarChar(255)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  site        Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@index([siteId])
  @@map("zones")
}

// ==================== WORK TYPES ====================

model WorkType {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @db.Uuid
  name         String   @db.VarChar(100)
  icon         String?  @db.VarChar(50)
  trade        String?  @db.VarChar(100)   // e.g. Concrete, Masonry, Plumbing
  billingUnit  String?  @db.VarChar(20)    // e.g. m, m², m³, no., t
  isDefault    Boolean  @default(false)
  sortOrder    Int      @default(0)
  customFields Json?
  photoSteps   Json?
  createdAt    DateTime @default(now())

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  siteWorkTypes SiteWorkType[]
  submissions   Submission[]

  @@unique([companyId, name])
  @@map("work_types")
}

model SiteWorkType {
  id         String @id @default(uuid()) @db.Uuid
  siteId     String @db.Uuid
  workTypeId String @db.Uuid

  site     Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  workType WorkType @relation(fields: [workTypeId], references: [id], onDelete: Cascade)

  @@unique([siteId, workTypeId])
  @@map("site_work_types")
}

// ==================== SITE ASSIGNMENTS ====================

model SiteWorker {
  id         String   @id @default(uuid()) @db.Uuid
  siteId     String   @db.Uuid
  workerId   String   @db.Uuid
  assignedAt DateTime @default(now())

  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([siteId, workerId])
  @@map("site_workers")
}

model SiteManager {
  id     String @id @default(uuid()) @db.Uuid
  siteId String @db.Uuid
  userId String @db.Uuid

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([siteId, userId])
  @@map("site_managers")
}

model SiteClient {
  id     String @id @default(uuid()) @db.Uuid
  siteId String @db.Uuid
  userId String @db.Uuid

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([siteId, userId])
  @@map("site_clients")
}

// ==================== SUBMISSIONS (Photo Proof) ====================

model Submission {
  id                 String           @id @default(uuid()) @db.Uuid
  siteId             String           @db.Uuid
  workerId           String           @db.Uuid
  workTypeId         String           @db.Uuid
  zoneId             String?          @db.Uuid
  status             SubmissionStatus @default(SUBMITTED)
  note               String?
  voiceNoteUrl       String?          @db.VarChar(500)
  latitude           Float
  longitude          Float
  gpsAccuracyM       Float?
  isWithinRadius     Boolean          @default(true)
  distanceFromSite   Float?
  deviceId           String?          @db.VarChar(255)
  deviceTimestamp     DateTime
  serverTimestamp     DateTime         @default(now())
  isBeforePhoto      Boolean          @default(false)
  linkedSubmissionId String?          @db.Uuid
  flagReason         String?
  flaggedBy          String?          @db.Uuid
  customData         Json?
  createdAt          DateTime         @default(now())

  site       Site                  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  worker     Worker                @relation(fields: [workerId], references: [id], onDelete: Cascade)
  workType   WorkType              @relation(fields: [workTypeId], references: [id], onDelete: Cascade)
  zone       Zone?                 @relation(fields: [zoneId], references: [id])
  photos     SubmissionPhoto[]
  shareLinks SubmissionShareLink[]

  @@index([siteId, createdAt(sort: Desc)])
  @@index([workerId, createdAt(sort: Desc)])
  @@index([siteId, workTypeId, createdAt(sort: Desc)])
  @@map("submissions")
}

model SubmissionPhoto {
  id             String   @id @default(uuid()) @db.Uuid
  submissionId   String   @db.Uuid
  photoUrl       String   @db.VarChar(500)
  thumbnailUrl   String?  @db.VarChar(500)
  originalWidth  Int?
  originalHeight Int?
  fileSizeBytes  Int?
  sortOrder      Int      @default(0)
  photoStepId    String?  @db.VarChar(100)
  latitude       Float?
  longitude      Float?
  capturedAt     DateTime?
  createdAt      DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("submission_photos")
}

// ==================== SHARE LINKS ====================

model SubmissionShareLink {
  id           String    @id @default(uuid()) @db.Uuid
  submissionId String    @db.Uuid
  shareToken   String    @unique @db.VarChar(64)
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("submission_share_links")
}

// ==================== ISSUES ====================

model Issue {
  id                 String        @id @default(uuid()) @db.Uuid
  siteId             String        @db.Uuid
  workerId           String        @db.Uuid
  category           String        @db.VarChar(100)
  severity           IssueSeverity @default(MEDIUM)
  status             IssueStatus   @default(OPEN)
  description        String?
  photoUrl           String?       @db.VarChar(500)
  latitude           Float?
  longitude          Float?
  response           String?
  respondedBy        String?       @db.Uuid
  respondedAt        DateTime?
  resolvedAt         DateTime?
  resolutionPhotoUrl String?       @db.VarChar(500)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([siteId, status, createdAt(sort: Desc)])
  @@map("issues")
}

// ==================== REPORTS ====================

model Report {
  id             String               @id @default(uuid()) @db.Uuid
  companyId      String               @db.Uuid
  siteId         String               @db.Uuid
  reportType     ReportType
  reportDate     DateTime             @db.Date
  periodStart    DateTime             @db.Date
  periodEnd      DateTime             @db.Date
  data           Json
  pdfUrl         String?              @db.VarChar(500)
  shareToken     String?              @unique @db.VarChar(64)
  deliveryStatus ReportDeliveryStatus @default(PENDING)
  deliveredTo    String[]
  createdAt      DateTime             @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site    Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, reportType, reportDate(sort: Desc)])
  @@map("reports")
}

// ==================== ALERTS ====================

model Alert {
  id          String   @id @default(uuid()) @db.Uuid
  siteId      String   @db.Uuid
  alertType   String   @db.VarChar(50)
  title       String   @db.VarChar(255)
  description String?
  metadata    Json?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, isRead, createdAt(sort: Desc)])
  @@map("alerts")
}

// ==================== DAILY SITE LOGS (Construction Billing) ====================

model DailySiteLog {
  id          String           @id @default(uuid()) @db.Uuid
  siteId      String           @db.Uuid
  logDate     DateTime         @db.Date
  weather     WeatherCondition?
  weatherNote String?
  crewCount   Int?
  workSummary String?
  createdBy   String           @db.Uuid
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  site           Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdByUser  User           @relation(fields: [createdBy], references: [id])
  equipmentLogs  EquipmentLog[]
  materialLogs   MaterialLog[]
  labourLogs     LabourLog[]
  billingPhotos  BillingPhoto[]

  @@unique([siteId, logDate])
  @@index([siteId, logDate(sort: Desc)])
  @@map("daily_site_logs")
}

model EquipmentLog {
  id               String            @id @default(uuid()) @db.Uuid
  dailyLogId       String            @db.Uuid
  name             String            @db.VarChar(255)
  type             EquipmentOwnership @default(RENTED)
  hoursUsed        Decimal?          @db.Decimal(6, 2)
  rentalCostPerHour Decimal?         @db.Decimal(10, 2)
  totalCost        Decimal?          @db.Decimal(12, 2)
  note             String?
  createdAt        DateTime          @default(now())

  dailyLog      DailySiteLog   @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  billingPhotos BillingPhoto[]

  @@index([dailyLogId])
  @@map("equipment_logs")
}

model MaterialLog {
  id            String   @id @default(uuid()) @db.Uuid
  dailyLogId    String   @db.Uuid
  item          String   @db.VarChar(255)
  quantity      Decimal  @db.Decimal(10, 2)
  unit          String   @db.VarChar(50)
  unitCost      Decimal? @db.Decimal(10, 2)
  totalCost     Decimal? @db.Decimal(12, 2)
  vendor        String?  @db.VarChar(255)
  invoiceNumber String?  @db.VarChar(100)
  trade         String?  @db.VarChar(100)
  note          String?
  createdAt     DateTime @default(now())

  dailyLog      DailySiteLog   @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  billingPhotos BillingPhoto[]

  @@index([dailyLogId])
  @@map("material_logs")
}

model LabourLog {
  id           String   @id @default(uuid()) @db.Uuid
  dailyLogId   String   @db.Uuid
  workerId     String?  @db.Uuid
  workerName   String   @db.VarChar(255)
  role         String   @db.VarChar(100)
  trade        String?  @db.VarChar(100)
  hoursWorked  Decimal? @db.Decimal(5, 2)
  dailyWage    Decimal? @db.Decimal(10, 2)
  overtime     Decimal? @db.Decimal(5, 2)
  overtimeRate Decimal? @db.Decimal(10, 2)
  note         String?
  paid         Boolean  @default(false)
  paidAt       DateTime?
  paidBy       String?  @db.VarChar(255)
  createdAt    DateTime @default(now())

  dailyLog DailySiteLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  worker   Worker?      @relation(fields: [workerId], references: [id])

  @@index([dailyLogId])
  @@map("labour_logs")
}

model BillingPhoto {
  id             String   @id @default(uuid()) @db.Uuid
  dailyLogId     String?  @db.Uuid
  equipmentLogId String?  @db.Uuid
  materialLogId  String?  @db.Uuid
  photoUrl       String   @db.VarChar(500)
  thumbnailUrl   String?  @db.VarChar(500)
  caption        String?  @db.VarChar(255)
  createdAt      DateTime @default(now())

  dailyLog     DailySiteLog? @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  equipmentLog EquipmentLog? @relation(fields: [equipmentLogId], references: [id], onDelete: Cascade)
  materialLog  MaterialLog?  @relation(fields: [materialLogId], references: [id], onDelete: Cascade)

  @@map("billing_photos")
}

// ==================== MEASUREMENT BOOK ====================

model MeasurementBook {
  id          String    @id @default(uuid()) @db.Uuid
  siteId      String    @db.Uuid
  companyId   String    @db.Uuid
  billNumber  String    @db.VarChar(50)
  title       String?   @db.VarChar(255)
  periodFrom  DateTime? @db.Date
  periodTo    DateTime? @db.Date
  status      MBStatus  @default(DRAFT)
  submittedBy String?   @db.Uuid
  submittedAt DateTime?
  reviewedBy  String?   @db.Uuid
  reviewedAt  DateTime?
  reviewNote  String?
  totalAmount Decimal   @default(0) @db.Decimal(14, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  site  Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  items MBItem[]

  @@index([siteId, status, createdAt(sort: Desc)])
  @@index([companyId, status])
  @@map("measurement_books")
}

model MBItem {
  id              String          @id @default(uuid()) @db.Uuid
  mbId            String          @db.Uuid
  description     String          @db.VarChar(500)
  unit            String          @db.VarChar(50)
  measurementType MeasurementType
  rate            Decimal?        @db.Decimal(12, 2)
  totalQty        Decimal         @default(0) @db.Decimal(14, 4)
  amount          Decimal         @default(0) @db.Decimal(14, 2)
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now())

  mb   MeasurementBook @relation(fields: [mbId], references: [id], onDelete: Cascade)
  rows MBRow[]

  @@index([mbId, sortOrder])
  @@map("mb_items")
}

model MBRow {
  id          String   @id @default(uuid()) @db.Uuid
  itemId      String   @db.Uuid
  description String?  @db.VarChar(255)
  nos         Decimal  @default(1)  @db.Decimal(8, 2)
  length      Decimal  @default(0)  @db.Decimal(10, 4)
  breadth     Decimal  @default(0)  @db.Decimal(10, 4)
  height      Decimal  @default(0)  @db.Decimal(10, 4)
  qty         Decimal  @default(0)  @db.Decimal(14, 4)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  item MBItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, sortOrder])
  @@map("mb_rows")
}

